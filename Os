function Win95UI:AddLogBox(windowOrSection, config)
    config = config or {}
    local size = config.Size or UDim2.new(1, -8, 0, 120)
    local zIndex = config.ZIndex or 1

    local group = Instance.new("Frame")
    group.Name = "LogGroup"
    group.Size = size
    group.BackgroundColor3 = Win95UI.Theme.GroupBoxBg
    group.BorderSizePixel = 0
    group.ZIndex = zIndex
    self:Add3DBorder(group, true)

    local title = config.Title
    if title then
        local titleLabel = Instance.new("TextLabel", group)
        titleLabel.Size = UDim2.new(0, title:len() * 7 + 10, 0, 14)
        titleLabel.Position = UDim2.new(0, 6, 0, 2)
        titleLabel.BackgroundColor3 = Win95UI.Theme.GroupBoxBg
        titleLabel.Text = " " .. title .. " "
        titleLabel.TextColor3 = Win95UI.Theme.GroupBoxText
        titleLabel.TextSize = 10
        titleLabel.Font = Win95UI.Theme.FontBold
        titleLabel.TextXAlignment = Enum.TextXAlignment.Left
        titleLabel.ZIndex = zIndex + 1
    end

    local scroll = Instance.new("ScrollingFrame", group)
    scroll.Name = "LogScroll"
    scroll.Size = UDim2.new(1, -8, 1, -20)
    scroll.Position = UDim2.new(0, 4, 0, 16)
    scroll.BackgroundColor3 = Win95UI.Theme.LogBg
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 12
    scroll.ScrollBarImageColor3 = Win95UI.Theme.ButtonFace
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.ZIndex = zIndex + 1
    self:Add3DBorder(scroll, true)

    local container = Instance.new("Frame", scroll)
    container.Name = "LogContainer"
    container.Size = UDim2.new(1, 0, 0, 0)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ZIndex = zIndex + 2

    local layout = Instance.new("UIListLayout", container)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 0)

    local maxEntries = config.MaxEntries or 100

    local function addLog(text, color)
        color = color or Win95UI.Theme.LogText
        local entry = Instance.new("TextLabel")
        entry.Size = UDim2.new(1, -8, 0, 16)
        entry.BackgroundTransparency = 1
        entry.Text = "[" .. os.date("%H:%M:%S") .. "] " .. text
        entry.TextColor3 = color
        entry.TextSize = 11
        entry.Font = Win95UI.Theme.Font
        entry.TextXAlignment = Enum.TextXAlignment.Left
        entry.TextTruncate = Enum.TextTruncate.AtEnd
        entry.ZIndex = zIndex + 3
        entry.Parent = container

        task.defer(function()
            scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 4)
            local visibleHeight = scroll.AbsoluteSize.Y
            local scrollY = math.max(0, layout.AbsoluteContentSize.Y + 4 - visibleHeight)
            scroll.CanvasPosition = Vector2.new(0, scrollY)
        end)

        local count = 0
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("TextLabel") then count = count + 1 end
        end
        if count > maxEntries then
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("TextLabel") then
                    child:Destroy()
                    break
                end
            end
        end
    end

    local function clearLogs()
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("TextLabel") then child:Destroy() end
        end
        scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    end

    if windowOrSection and windowOrSection.AddElement then
        windowOrSection:AddElement(group, size.Y.Offset or 120)
    end

    local Element = {
        Frame = group,
        Type = "LogBox",
        AddLog = addLog,
        Clear = clearLogs
    }

    return Element
end

function Win95UI:AddKeybind(windowOrSection, config)
    config = config or {}
