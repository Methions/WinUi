    label.TextSize = 11
    label.Font = Win95UI.Theme.Font
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = zIndex + 1

    local keyBtn = Instance.new("TextButton", container)
    keyBtn.Name = "KeyBtn"
    keyBtn.Size = UDim2.new(0, 70, 0, 22)
    keyBtn.Position = UDim2.new(1, -74, 0.5, -11)
    keyBtn.BackgroundColor3 = Win95UI.Theme.ButtonFace
    keyBtn.Text = default ~= Enum.KeyCode.Unknown and default.Name or "None"
    keyBtn.TextColor3 = Win95UI.Theme.ButtonText
    keyBtn.TextSize = 10
    keyBtn.Font = Win95UI.Theme.FontMedium
    keyBtn.AutoButtonColor = false
    keyBtn.ZIndex = zIndex + 1
    keyBtn.BorderSizePixel = 0
    self:Add3DBorder(keyBtn, false)

    local currentKey = default
    local listening = false

    keyBtn.MouseButton1Click:Connect(function()
        listening = true
        keyBtn.Text = "..."
    end)

    UserInputService.InputBegan:Connect(function(input)
        if listening then
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                currentKey = input.KeyCode
                keyBtn.Text = currentKey.Name
                listening = false
                local ok, err = pcall(function() callback(currentKey) end)
                if not ok then warn("[Win95UI Keybind Error] " .. tostring(err)) end
            end
        elseif input.KeyCode == currentKey then
            local ok, err = pcall(function() callback(currentKey) end)
            if not ok then warn("[Win95UI Keybind Error] " .. tostring(err)) end
        end
    end)

    if windowOrSection and windowOrSection.AddElement then
        windowOrSection:AddElement(container, 26)
    end

    local Element = {
        Frame = container,
        Type = "Keybind",
        GetKey = function() return currentKey end,
        SetKey = function(self, key)
            currentKey = key
            keyBtn.Text = key ~= Enum.KeyCode.Unknown and key.Name or "None"
        end,
        SetText = function(self, newText)
            label.Text = newText
        end
    }

    return Element
end

function Win95UI:AddColorPicker(windowOrSection, config)
    config = config or {}
    local text = config.Text or "Color"
    local default = config.Default or Color3.fromRGB(255, 255, 255)
    local callback = config.Callback or function() end
    local zIndex = config.ZIndex or 1

    local container = Instance.new("Frame")
    container.Name = text .. "_ColorPicker"
    container.Size = UDim2.new(1, -8, 0, 26)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ZIndex = zIndex

    local label = Instance.new("TextLabel", container)
    label.Name = "Label"
    label.Size = UDim2.new(1, -40, 1, 0)
    label.Position = UDim2.new(0, 2, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Win95UI.Theme.ButtonText
    label.TextSize = 11
    label.Font = Win95UI.Theme.Font
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = zIndex + 1

    local preview = Instance.new("TextButton", container)
    preview.Name = "Preview"
    preview.Size = UDim2.new(0, 30, 0, 20)
    preview.Position = UDim2.new(1, -34, 0.5, -10)
    preview.BackgroundColor3 = default
    preview.Text = ""
    preview.AutoButtonColor = false
    preview.ZIndex = zIndex + 1
    preview.BorderSizePixel = 0
    self:Add3DBorder(preview, true)

    local currentColor = default

    preview.MouseButton1Click:Connect(function()
        local pickerGui = Instance.new("ScreenGui")
        pickerGui.Name = "ColorPickerDialog"
        pickerGui.ResetOnSpawn = false
        pickerGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        pcall(function() pickerGui.Parent = game:GetService("CoreGui") end)
        if not pickerGui.Parent then pickerGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

        local bg = Instance.new("Frame", pickerGui)
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(0,0,0)
        bg.BackgroundTransparency = 0.5
        bg.BorderSizePixel = 0
        bg.ZIndex = 200

        local dialog = Instance.new("Frame", bg)
        dialog.Size = UDim2.new(0, 260, 0, 200)
        dialog.Position = UDim2.new(0.5, -130, 0.5, -100)
        dialog.BackgroundColor3 = Win95UI.Theme.WindowBg
        dialog.BorderSizePixel = 0
        dialog.ZIndex = 201
        self:Add3DBorder(dialog, true)

        local titleBar = Instance.new("Frame", dialog)
        titleBar.Size = UDim2.new(1, -4, 0, 22)
        titleBar.Position = UDim2.new(0, 2, 0, 2)
        titleBar.BackgroundColor3 = Win95UI.Theme.TitleBar
        titleBar.BorderSizePixel = 0
        titleBar.ZIndex = 202

        local title = Instance.new("TextLabel", titleBar)
        title.Size = UDim2.new(1, -30, 1, 0)
        title.Position = UDim2.new(0, 6, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = "Color Picker"
        title.TextColor3 = Win95UI.Theme.TitleText
        title.TextSize = 11
        title.Font = Win95UI.Theme.FontBold
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.ZIndex = 203

        local closeBtn = Instance.new("TextButton", titleBar)
        closeBtn.Size = UDim2.new(0, 18, 0, 16)
        closeBtn.Position = UDim2.new(1, -22, 0, 3)
        closeBtn.BackgroundColor3 = Win95UI.Theme.ButtonFace
        closeBtn.Text = "X"
        closeBtn.TextColor3 = Win95UI.Theme.ButtonText
        closeBtn.TextSize = 11
        closeBtn.Font = Win95UI.Theme.FontBold
        closeBtn.AutoButtonColor = false
        closeBtn.ZIndex = 203
        self:Add3DBorder(closeBtn, false)

        local rSlider = self:AddSlider(nil, {
            Text = "R", Min = 0, Max = 255, Default = math.floor(default.R * 255),
            ZIndex = 202
        })
        rSlider.Frame.Parent = dialog
        rSlider.Frame.Size = UDim2.new(1, -16, 0, 40)
        rSlider.Frame.Position = UDim2.new(0, 8, 0, 30)

        local gSlider = self:AddSlider(nil, {
            Text = "G", Min = 0, Max = 255, Default = math.floor(default.G * 255),
            ZIndex = 202
        })
        gSlider.Frame.Parent = dialog
        gSlider.Frame.Size = UDim2.new(1, -16, 0, 40)
        gSlider.Frame.Position = UDim2.new(0, 8, 0, 72)

        local bSlider = self:AddSlider(nil, {
            Text = "B", Min = 0, Max = 255, Default = math.floor(default.B * 255),
            ZIndex = 202
        })
        bSlider.Frame.Parent = dialog
        bSlider.Frame.Size = UDim2.new(1, -16, 0, 40)
        bSlider.Frame.Position = UDim2.new(0, 8, 0, 114)

        local previewBox = Instance.new("Frame", dialog)
        previewBox.Size = UDim2.new(0, 60, 0, 24)
        previewBox.Position = UDim2.new(0.5, -30, 1, -34)
        previewBox.BackgroundColor3 = default
        previewBox.BorderSizePixel = 0
        previewBox.ZIndex = 202
        self:Add3DBorder(previewBox, true)

        local function updatePreview()
            local r = rSlider.GetValue()
            local g = gSlider.GetValue()
            local b = bSlider.GetValue()
            local color = Color3.fromRGB(r, g, b)
            previewBox.BackgroundColor3 = color
        end

        rSlider.SetCallback = function(self, cb) end
        gSlider.SetCallback = function(self, cb) end
        bSlider.SetCallback = function(self, cb) end

        local oldR = rSlider.Frame:FindFirstChild("Track"):FindFirstChild("Knob")
        local oldG = gSlider.Frame:FindFirstChild("Track"):FindFirstChild("Knob")
        local oldB = bSlider.Frame:FindFirstChild("Track"):FindFirstChild("Knob")

        local conn = RunService.RenderStepped:Connect(updatePreview)

        local okBtn = self:CreateClassicButton({
            Text = "OK",
            Size = UDim2.new(0, 60, 0, 22),
            Position = UDim2.new(0.5, -70, 1, -34),
            Accent = true,
            ZIndex = 202,
            Parent = dialog
        })

        local cancelBtn = self:CreateClassicButton({
            Text = "Cancel",
            Size = UDim2.new(0, 60, 0, 22),
            Position = UDim2.new(0.5, 10, 1, -34),
            ZIndex = 202,
            Parent = dialog
        })

        okBtn.MouseButton1Click:Connect(function()
            currentColor = previewBox.BackgroundColor3
            preview.BackgroundColor3 = currentColor
            conn:Disconnect()
            pickerGui:Destroy()
            local ok, err = pcall(function() callback(currentColor) end)
            if not ok then warn("[Win95UI ColorPicker Error] " .. tostring(err)) end
        end)

        cancelBtn.MouseButton1Click:Connect(function()
            conn:Disconnect()
            pickerGui:Destroy()
        end)

        closeBtn.MouseButton1Click:Connect(function()
            conn:Disconnect()
            pickerGui:Destroy()
        end)
    end)

    if windowOrSection and windowOrSection.AddElement then
        windowOrSection:AddElement(container, 26)
    end

    local Element = {
        Frame = container,
        Type = "ColorPicker",
        GetColor = function() return currentColor end,
        SetColor = function(self, color)
            currentColor = color
            preview.BackgroundColor3 = color
            local ok, err = pcall(function() callback(color) end)
            if not ok then warn("[Win95UI ColorPicker Error] " .. tostring(err)) end
        end,
        SetText = function(self, newText)
            label.Text = newText
        end
    }

    return Element
end

