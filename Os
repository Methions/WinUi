    label.TextSize = 11
    label.Font = Win95UI.Theme.Font
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = zIndex + 1

    local display = Instance.new("TextButton", container)
    display.Name = "Display"
    display.Size = UDim2.new(1, 0, 0, 24)
    display.Position = UDim2.new(0, 0, 0, 18)
    display.BackgroundColor3 = Win95UI.Theme.InputBg
    display.Text = default
    display.TextColor3 = Win95UI.Theme.InputText
    display.TextSize = 11
    display.Font = Win95UI.Theme.Font
    display.TextXAlignment = Enum.TextXAlignment.Left
    display.AutoButtonColor = false
    display.ZIndex = zIndex + 1
    display.BorderSizePixel = 0
    self:Add3DBorder(display, true)

    local arrow = Instance.new("TextLabel", display)
    arrow.Name = "Arrow"
    arrow.Size = UDim2.new(0, 20, 1, 0)
    arrow.Position = UDim2.new(1, -20, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "v"
    arrow.TextColor3 = Win95UI.Theme.ButtonText
    arrow.TextSize = 12
    arrow.Font = Win95UI.Theme.FontBold
    arrow.ZIndex = zIndex + 2

    local dropdownFrame = Instance.new("Frame", container)
    dropdownFrame.Name = "DropdownFrame"
    dropdownFrame.Size = UDim2.new(1, 0, 0, 0)
    dropdownFrame.Position = UDim2.new(0, 0, 0, 44)
    dropdownFrame.BackgroundColor3 = Win95UI.Theme.InputBg
    dropdownFrame.BorderSizePixel = 0
    dropdownFrame.ZIndex = zIndex + 10
    dropdownFrame.Visible = false
    dropdownFrame.ClipsDescendants = true
    self:Add3DBorder(dropdownFrame, true)

    local scroll = Instance.new("ScrollingFrame", dropdownFrame)
    scroll.Name = "Scroll"
    scroll.Size = UDim2.new(1, -4, 1, -4)
    scroll.Position = UDim2.new(0, 2, 0, 2)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 8
    scroll.ScrollBarImageColor3 = Win95UI.Theme.ButtonFace
    scroll.ZIndex = zIndex + 11
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)

    local layout = Instance.new("UIListLayout", scroll)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 1)

    local selected = default
    local open = false

    local function buildOptions()
        for _, child in ipairs(scroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for _, opt in ipairs(options) do
            local optBtn = Instance.new("TextButton", scroll)
            optBtn.Size = UDim2.new(1, 0, 0, 20)
            optBtn.BackgroundColor3 = Win95UI.Theme.InputBg
            optBtn.Text = opt
            optBtn.TextColor3 = Win95UI.Theme.InputText
            optBtn.TextSize = 11
            optBtn.Font = Win95UI.Theme.Font
            optBtn.AutoButtonColor = false
            optBtn.ZIndex = zIndex + 12
            optBtn.BorderSizePixel = 0

            optBtn.MouseEnter:Connect(function()
                optBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 128)
                optBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            end)
            optBtn.MouseLeave:Connect(function()
                optBtn.BackgroundColor3 = Win95UI.Theme.InputBg
                optBtn.TextColor3 = Win95UI.Theme.InputText
            end)

            optBtn.MouseButton1Click:Connect(function()
                selected = opt
                display.Text = opt
                open = false
                dropdownFrame.Visible = false
                dropdownFrame.Size = UDim2.new(1, 0, 0, 0)
                local ok, err = pcall(function() callback(opt) end)
                if not ok then warn("[Win95UI Dropdown Error] " .. tostring(err)) end
            end)
        end
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
    end

    buildOptions()

    display.MouseButton1Click:Connect(function()
        open = not open
        if open then
            local maxHeight = math.min(#options * 21 + 4, 150)
            dropdownFrame.Size = UDim2.new(1, 0, 0, maxHeight)
            dropdownFrame.Visible = true
        else
            dropdownFrame.Size = UDim2.new(1, 0, 0, 0)
            dropdownFrame.Visible = false
        end
    end)

    UserInputService.InputBegan:Connect(function(input)
        if open and input.UserInputType == Enum.UserInputType.MouseButton1 then
            local pos = input.Position
            local absPos = dropdownFrame.AbsolutePosition
            local absSize = dropdownFrame.AbsoluteSize
            if pos.X < absPos.X or pos.X > absPos.X + absSize.X or
               pos.Y < absPos.Y or pos.Y > absPos.Y + absSize.Y then
                open = false
                dropdownFrame.Size = UDim2.new(1, 0, 0, 0)
                dropdownFrame.Visible = false
            end
        end
    end)

    if windowOrSection and windowOrSection.AddElement then
        windowOrSection:AddElement(container, 48)
    end

    local Element = {
        Frame = container,
        Type = "Dropdown",
        GetSelected = function() return selected end,
        SetSelected = function(self, opt)
            if table.find(options, opt) then
                selected = opt
                display.Text = opt
                local ok, err = pcall(function() callback(opt) end)
                if not ok then warn("[Win95UI Dropdown Error] " .. tostring(err)) end
            end
        end,
        Refresh = function(self, newOptions)
            options = newOptions
            buildOptions()
        end,
        SetText = function(self, newText)
            label.Text = newText
        end
    }

    return Element
end

