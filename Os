function Win95UI:Notify(title, text, duration)
    duration = duration or 4
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "Win95UI",
            Duration = duration,
            Text = text or ""
        })
    end)
end


function Win95UI:Add3DBorder(parent, inset)
    inset = inset or false
    local tl = inset and Win95UI.Theme.ButtonShadow or Win95UI.Theme.ButtonHighlight
    local br = inset and Win95UI.Theme.ButtonHighlight or Win95UI.Theme.ButtonShadow

    local top = Instance.new("Frame")
    top.Name = "BorderTop"
    top.Size = UDim2.new(1, 0, 0, 1)
    top.Position = UDim2.new(0, 0, 0, 0)
    top.BackgroundColor3 = tl
    top.BorderSizePixel = 0
    top.ZIndex = parent.ZIndex + 1
    top.Parent = parent

    local left = Instance.new("Frame")
    left.Name = "BorderLeft"
    left.Size = UDim2.new(0, 1, 1, -2)
    left.Position = UDim2.new(0, 0, 0, 1)
    left.BackgroundColor3 = tl
    left.BorderSizePixel = 0
    left.ZIndex = parent.ZIndex + 1
    left.Parent = parent

    local right = Instance.new("Frame")
    right.Name = "BorderRight"
    right.Size = UDim2.new(0, 1, 1, -2)
    right.Position = UDim2.new(1, -1, 0, 1)
    right.BackgroundColor3 = br
    right.BorderSizePixel = 0
    right.ZIndex = parent.ZIndex + 1
    right.Parent = parent

    local bottom = Instance.new("Frame")
    bottom.Name = "BorderBottom"
    bottom.Size = UDim2.new(1, 0, 0, 1)
    bottom.Position = UDim2.new(0, 0, 1, -1)
    bottom.BackgroundColor3 = br
    bottom.BorderSizePixel = 0
    bottom.ZIndex = parent.ZIndex + 1
    bottom.Parent = parent
end

function Win95UI:CreateClassicButton(config)
    config = config or {}
    local parent = config.Parent
    local text = config.Text or "Button"
    local size = config.Size or UDim2.new(1, -10, 0, 26)
    local pos = config.Position or UDim2.new(0, 5, 0, 0)
    local accent = config.Accent or false
    local zIndex = config.ZIndex or 1

    local btn = Instance.new("TextButton")
    btn.Name = text
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = accent and Win95UI.Theme.Accent or Win95UI.Theme.ButtonFace
    btn.Text = text
    btn.TextColor3 = accent and Color3.fromRGB(255,255,255) or Win95UI.Theme.ButtonText
    btn.TextSize = 12
    btn.Font = Win95UI.Theme.FontMedium
    btn.AutoButtonColor = false
    btn.ZIndex = zIndex
    btn.BorderSizePixel = 0
    if parent then btn.Parent = parent end

    self:Add3DBorder(btn, false)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {
            BackgroundColor3 = accent and Color3.fromRGB(0,0,160) or Color3.fromRGB(200,200,200)
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {
            BackgroundColor3 = accent and Win95UI.Theme.Accent or Win95UI.Theme.ButtonFace
        }):Play()
    end)

    local function swapBorders()
        for _, child in ipairs(btn:GetChildren()) do
            if child:IsA("Frame") and child.Name:find("Border") then
                local current = child.BackgroundColor3
                if current == Win95UI.Theme.ButtonHighlight then
                    child.BackgroundColor3 = Win95UI.Theme.ButtonShadow
                elseif current == Win95UI.Theme.ButtonShadow then
                    child.BackgroundColor3 = Win95UI.Theme.ButtonHighlight
                end
            end
        end
    end

    btn.MouseButton1Down:Connect(swapBorders)
    btn.MouseButton1Up:Connect(swapBorders)

    return btn
end

function Win95UI:MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragInput, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end



function Win95UI:CreateWindow(config)
    config = config or {}
    local title = config.Title or "Window"
    local size = config.Size or UDim2.new(0, 500, 0, 350)
    local pos = config.Position or UDim2.new(0.5, -250, 0.5, -175)
    local showStatusBar = config.StatusBar ~= false
    local statusText = config.StatusText or "Ready"
    local icon = config.Icon or "?"
    local canMinimize = config.CanMinimize ~= false
    local canClose = config.CanClose ~= false

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "Win95UI_" .. title:gsub("%s+", "_")
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function()
        ScreenGui.Parent = game:GetService("CoreGui")
    end)
    if not ScreenGui.Parent then
        ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Size = size
    Main.Position = pos
    Main.BackgroundColor3 = Win95UI.Theme.WindowBg
    Main.BorderSizePixel = 0
    Main.Active = true
    Main.ClipsDescendants = true
    Main.Parent = ScreenGui
    self:Add3DBorder(Main, true)

    local TitleBar = Instance.new("Frame")
    TitleBar.Name = "TitleBar"
    TitleBar.Size = UDim2.new(1, -4, 0, 26)
    TitleBar.Position = UDim2.new(0, 2, 0, 2)
    TitleBar.BackgroundColor3 = Win95UI.Theme.TitleBar
    TitleBar.BorderSizePixel = 0
    TitleBar.Active = true
    TitleBar.Parent = Main

    local TitleIcon = Instance.new("TextLabel", TitleBar)
    TitleIcon.Name = "TitleIcon"
    TitleIcon.Size = UDim2.new(0, 18, 0, 18)
    TitleIcon.Position = UDim2.new(0, 4, 0, 4)
    TitleIcon.BackgroundTransparency = 1
    TitleIcon.Text = icon
    TitleIcon.TextColor3 = Color3.fromRGB(255,255,255)
    TitleIcon.TextSize = 12
    TitleIcon.Font = Win95UI.Theme.FontBold

    local TitleLabel = Instance.new("TextLabel", TitleBar)
    TitleLabel.Name = "TitleLabel"
    TitleLabel.Size = UDim2.new(1, -100, 1, 0)
    TitleLabel.Position = UDim2.new(0, 24, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = title
    TitleLabel.TextColor3 = Win95UI.Theme.TitleText
    TitleLabel.TextSize = 12
    TitleLabel.Font = Win95UI.Theme.FontBold
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    local CloseBtn
    if canClose then
        CloseBtn = Instance.new("TextButton", TitleBar)
        CloseBtn.Name = "CloseBtn"
        CloseBtn.Size = UDim2.new(0, 20, 0, 18)
        CloseBtn.Position = UDim2.new(1, -24, 0, 4)
        CloseBtn.BackgroundColor3 = Win95UI.Theme.ButtonFace
        CloseBtn.Text = "X"
        CloseBtn.TextColor3 = Win95UI.Theme.ButtonText
        CloseBtn.TextSize = 12
        CloseBtn.Font = Win95UI.Theme.FontBold
        CloseBtn.AutoButtonColor = false
        self:Add3DBorder(CloseBtn, false)
    end

    local MinBtn
    if canMinimize then
        MinBtn = Instance.new("TextButton", TitleBar)
        MinBtn.Name = "MinBtn"
        MinBtn.Size = UDim2.new(0, 20, 0, 18)
        MinBtn.Position = canClose and UDim2.new(1, -48, 0, 4) or UDim2.new(1, -24, 0, 4)
        MinBtn.BackgroundColor3 = Win95UI.Theme.ButtonFace
        MinBtn.Text = "_"
        MinBtn.TextColor3 = Win95UI.Theme.ButtonText
        MinBtn.TextSize = 12
        MinBtn.Font = Win95UI.Theme.FontBold
        MinBtn.AutoButtonColor = false
        self:Add3DBorder(MinBtn, false)
    end

    local Content = Instance.new("Frame")
    Content.Name = "Content"
    local statusOffset = showStatusBar and 56 or 34
    Content.Size = UDim2.new(1, -8, 1, -statusOffset)
    Content.Position = UDim2.new(0, 4, 0, 30)
    Content.BackgroundTransparency = 1
    Content.Parent = Main

    local StatusBar, StatusTextLabel
    if showStatusBar then
        StatusBar = Instance.new("Frame")
        StatusBar.Name = "StatusBar"
        StatusBar.Size = UDim2.new(1, -8, 0, 20)
        StatusBar.Position = UDim2.new(0, 4, 1, -22)
        StatusBar.BackgroundColor3 = Win95UI.Theme.StatusBarBg
        StatusBar.BorderSizePixel = 0
        StatusBar.Parent = Main
        self:Add3DBorder(StatusBar, true)

        StatusTextLabel = Instance.new("TextLabel", StatusBar)
        StatusTextLabel.Name = "StatusText"
        StatusTextLabel.Size = UDim2.new(1, -8, 1, 0)
        StatusTextLabel.Position = UDim2.new(0, 4, 0, 0)
        StatusTextLabel.BackgroundTransparency = 1
        StatusTextLabel.Text = statusText
        StatusTextLabel.TextColor3 = Win95UI.Theme.StatusBarText
        StatusTextLabel.TextSize = 11
        StatusTextLabel.Font = Win95UI.Theme.Font
        StatusTextLabel.TextXAlignment = Enum.TextXAlignment.Left
    end

    self:MakeDraggable(Main, TitleBar)

    if CloseBtn then
        CloseBtn.MouseButton1Click:Connect(function()
            ScreenGui:Destroy()
        end)
    end

    if MinBtn then
        MinBtn.MouseButton1Click:Connect(function()
            Main.Visible = false
            self:Notify(title, "Press Left Alt to restore window", 3)
        end)
    end

    local altConnection
    altConnection = UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.LeftAlt then
            if Main and Main.Parent then
                Main.Visible = not Main.Visible
            else
                altConnection:Disconnect()
            end
        end
    end)

    local Window = {
        ScreenGui = ScreenGui,
        Main = Main,
        TitleBar = TitleBar,
        Content = Content,
        StatusBar = StatusBar,
        StatusText = StatusTextLabel,
        Elements = {},
        ElementCount = 0
    }

    function Window:SetStatus(text)
        if self.StatusText then
            self.StatusText.Text = text
        end
    end

    function Window:SetTitle(text)
        TitleLabel.Text = text
    end

    function Window:SetVisible(visible)
        self.Main.Visible = visible
    end

    function Window:Destroy()
        self.ScreenGui:Destroy()
    end

    table.insert(Win95UI.Windows, Window)
    return Window
end



function Win95UI:AddSection(window, config)
    config = config or {}
    local parent = config.Parent or window.Content
    local title = config.Title or ""
    local size = config.Size or UDim2.new(1, -8, 0, 120)
    local pos = config.Position or UDim2.new(0, 4, 0, 0)
    local zIndex = config.ZIndex or 1

    local group = Instance.new("Frame")
    group.Name = title ~= "" and (title .. "_Group") or "Group"
    group.Size = size
    group.Position = pos
    group.BackgroundColor3 = Win95UI.Theme.GroupBoxBg
    group.BorderSizePixel = 0
    group.ZIndex = zIndex
    group.Parent = parent
    self:Add3DBorder(group, true)

    if title ~= "" then
        local label = Instance.new("TextLabel", group)
        label.Name = "GroupLabel"
        label.Size = UDim2.new(0, title:len() * 7 + 10, 0, 14)
        label.Position = UDim2.new(0, 6, 0, 2)
        label.BackgroundColor3 = Win95UI.Theme.GroupBoxBg
        label.Text = " " .. title .. " "
        label.TextColor3 = Win95UI.Theme.GroupBoxText
        label.TextSize = 10
        label.Font = Win95UI.Theme.FontBold
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.ZIndex = zIndex + 1
    end

    local container = Instance.new("Frame")
    container.Name = "Container"
    container.Size = UDim2.new(1, -8, 1, -16)
    container.Position = UDim2.new(0, 4, 0, 14)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ZIndex = zIndex
    container.Parent = group

    local Section = {
        Frame = group,
        Container = container,
        Elements = {},
        ElementCount = 0,
        YOffset = 4
    }

    function Section:AddElement(elementFrame, height)
        height = height or 28
        elementFrame.Position = UDim2.new(0, 4, 0, self.YOffset)
        elementFrame.Parent = self.Container
        self.YOffset = self.YOffset + height + 4
        table.insert(self.Elements, elementFrame)
        return elementFrame
    end

    table.insert(window.Elements, Section)
    return Section
end

function Win95UI:AddButton(windowOrSection, config)
    config = config or {}
    local text = config.Text or "Button"
    local callback = config.Callback or function() end
    local accent = config.Accent or false
    local size = config.Size or UDim2.new(1, -8, 0, 26)
    local zIndex = config.ZIndex or 1

    local btn = self:CreateClassicButton({
        Text = text,
        Size = size,
        Accent = accent,
        ZIndex = zIndex
    })

    btn.MouseButton1Click:Connect(function()
        local ok, err = pcall(callback)
        if not ok then
            warn("[Win95UI Button Error] " .. tostring(err))
        end
    end)

    if windowOrSection and windowOrSection.AddElement then
        windowOrSection:AddElement(btn, 26)
    end

    local Element = {
        Frame = btn,
        Type = "Button",
        SetText = function(self, newText)
            btn.Text = newText
        end,
        SetCallback = function(self, newCallback)
            callback = newCallback
        end,
        Click = function(self)
            btn.MouseButton1Click:Fire()
        end
    }

    return Element
end

function Win95UI:AddToggle(windowOrSection, config)
    config = config or {}
    local text = config.Text or "Toggle"
    local default = config.Default or false
    local callback = config.Callback or function() end
    local zIndex = config.ZIndex or 1

    local container = Instance.new("Frame")
    container.Name = text .. "_Toggle"
    container.Size = UDim2.new(1, -8, 0, 22)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ZIndex = zIndex

    local box = Instance.new("Frame", container)
    box.Name = "Checkbox"
    box.Size = UDim2.new(0, 14, 0, 14)
    box.Position = UDim2.new(0, 2, 0.5, -7)
    box.BackgroundColor3 = Win95UI.Theme.InputBg
    box.BorderSizePixel = 0
    box.ZIndex = zIndex + 1
    self:Add3DBorder(box, true)

    local check = Instance.new("TextLabel", box)
    check.Name = "Checkmark"
    check.Size = UDim2.new(1, 0, 1, 0)
    check.BackgroundTransparency = 1
    check.Text = "x"
    check.TextColor3 = Color3.fromRGB(0,0,0)
    check.TextSize = 12
    check.Font = Win95UI.Theme.FontBold
    check.ZIndex = zIndex + 2
    check.Visible = default

    local label = Instance.new("TextLabel", container)
    label.Name = "Label"
    label.Size = UDim2.new(1, -24, 1, 0)
    label.Position = UDim2.new(0, 22, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Win95UI.Theme.ButtonText
    label.TextSize = 12
    label.Font = Win95UI.Theme.Font
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = zIndex + 1

    local state = default

    local function update()
        check.Visible = state
        local ok, err = pcall(function() callback(state) end)
        if not ok then warn("[Win95UI Toggle Error] " .. tostring(err)) end
    end

    container.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            state = not state
            update()
        end
    end)

    if windowOrSection and windowOrSection.AddElement then
        windowOrSection:AddElement(container, 22)
    end

    local Element = {
        Frame = container,
        Type = "Toggle",
        GetState = function() return state end,
        SetState = function(self, newState)
            state = newState
            update()
        end,
        SetText = function(self, newText)
            label.Text = newText
        end
    }

    return Element
end

function Win95UI:AddSlider(windowOrSection, config)
    config = config or {}
    local text = config.Text or "Slider"
    local min = config.Min or 0
    local max = config.Max or 100
    local default = config.Default or min
    local increment = config.Increment or 1
    local callback = config.Callback or function() end
    local suffix = config.Suffix or ""
    local zIndex = config.ZIndex or 1

    local container = Instance.new("Frame")
    container.Name = text .. "_Slider"
    container.Size = UDim2.new(1, -8, 0, 40)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ZIndex = zIndex

    local label = Instance.new("TextLabel", container)
    label.Name = "Label"
    label.Size = UDim2.new(1, -60, 0, 14)
    label.Position = UDim2.new(0, 2, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Win95UI.Theme.ButtonText
    label.TextSize = 11
    label.Font = Win95UI.Theme.Font
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = zIndex + 1

    local valueLabel = Instance.new("TextLabel", container)
    valueLabel.Name = "ValueLabel"
    valueLabel.Size = UDim2.new(0, 55, 0, 14)
    valueLabel.Position = UDim2.new(1, -57, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(default) .. suffix
    valueLabel.TextColor3 = Win95UI.Theme.ButtonText
    valueLabel.TextSize = 11
    valueLabel.Font = Win95UI.Theme.Font
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.ZIndex = zIndex + 1

    local track = Instance.new("Frame", container)
    track.Name = "Track"
    track.Size = UDim2.new(1, -8, 0, 14)
    track.Position = UDim2.new(0, 4, 0, 20)
    track.BackgroundColor3 = Win95UI.Theme.InputBg
    track.BorderSizePixel = 0
    track.ZIndex = zIndex + 1
    self:Add3DBorder(track, true)

    local fill = Instance.new("Frame", track)
    fill.Name = "Fill"
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Win95UI.Theme.Accent
    fill.BorderSizePixel = 0
    fill.ZIndex = zIndex + 2

    local knob = Instance.new("Frame", track)
    knob.Name = "Knob"
    knob.Size = UDim2.new(0, 8, 1, 4)
    knob.Position = UDim2.new(0, -4, 0, -2)
    knob.BackgroundColor3 = Win95UI.Theme.ButtonFace
    knob.BorderSizePixel = 0
    knob.ZIndex = zIndex + 3
    self:Add3DBorder(knob, false)

    local value = math.clamp(default, min, max)

    local function setValue(newVal)
        newVal = math.clamp(newVal, min, max)
        if increment > 0 then
            newVal = math.floor((newVal - min) / increment + 0.5) * increment + min
        end
        value = newVal
        local percent = (value - min) / (max - min)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        knob.Position = UDim2.new(percent, -4, 0, -2)
        valueLabel.Text = tostring(value) .. suffix
        local ok, err = pcall(function() callback(value) end)
        if not ok then warn("[Win95UI Slider Error] " .. tostring(err)) end
    end

    setValue(value)

    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local absPos = track.AbsolutePosition.X
            local absSize = track.AbsoluteSize.X
            local relX = math.clamp((input.Position.X - absPos) / absSize, 0, 1)
            setValue(min + relX * (max - min))
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local absPos = track.AbsolutePosition.X
            local absSize = track.AbsoluteSize.X
            local relX = math.clamp((input.Position.X - absPos) / absSize, 0, 1)
            setValue(min + relX * (max - min))
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    if windowOrSection and windowOrSection.AddElement then
        windowOrSection:AddElement(container, 40)
    end

    local Element = {
        Frame = container,
        Type = "Slider",
        GetValue = function() return value end,
        SetValue = function(self, newVal)
            setValue(newVal)
        end,
        SetText = function(self, newText)
            label.Text = newText
        end
    }

    return Element
end


function Win95UI:AddTextBox(windowOrSection, config)
    config = config or {}
    local text = config.Text or ""
    local placeholder = config.Placeholder or "Enter text..."
    local callback = config.Callback or function() end
    local multiline = config.Multiline or false
    local clearOnFocus = config.ClearOnFocus or false
    local zIndex = config.ZIndex or 1
    local height = config.Height or (multiline and 80 or 28)

    local container = Instance.new("Frame")
    container.Name = (config.Name or "TextBox") .. "_Input"
    container.Size = UDim2.new(1, -8, 0, height)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ZIndex = zIndex

    local box = Instance.new("TextBox", container)
    box.Name = "Input"
    box.Size = UDim2.new(1, 0, 1, 0)
    box.Position = UDim2.new(0, 0, 0, 0)
    box.BackgroundColor3 = Win95UI.Theme.InputBg
    box.Text = text
    box.PlaceholderText = placeholder
    box.PlaceholderColor3 = Color3.fromRGB(128, 128, 128)
    box.TextColor3 = Win95UI.Theme.InputText
    box.TextSize = 11
    box.Font = multiline and Win95UI.Theme.CodeFont or Win95UI.Theme.Font
    box.MultiLine = multiline
    box.ClearTextOnFocus = clearOnFocus
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.TextYAlignment = multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center
    box.TextWrapped = multiline
    box.ZIndex = zIndex + 1
    box.BorderSizePixel = 0
    self:Add3DBorder(box, true)

    if config.FocusLostCallback then
        box.FocusLost:Connect(function(enterPressed)
            local ok, err = pcall(function() config.FocusLostCallback(box.Text, enterPressed) end)
            if not ok then warn("[Win95UI TextBox Error] " .. tostring(err)) end
        end)
    end

    box:GetPropertyChangedSignal("Text"):Connect(function()
        local ok, err = pcall(function() callback(box.Text) end)
        if not ok then warn("[Win95UI TextBox Error] " .. tostring(err)) end
    end)

    if windowOrSection and windowOrSection.AddElement then
        windowOrSection:AddElement(container, height)
    end

    local Element = {
        Frame = container,
        Type = "TextBox",
        GetText = function() return box.Text end,
        SetText = function(self, newText)
            box.Text = newText
        end,
        Focus = function(self)
            box:CaptureFocus()
        end
    }

    return Element
end

function Win95UI:AddDropdown(windowOrSection, config)
    config = config or {}
    local text = config.Text or "Select"
    local options = config.Options or {}
    local default = config.Default or (options[1] or "")
    local callback = config.Callback or function() end
    local zIndex = config.ZIndex or 1

    local container = Instance.new("Frame")
    container.Name = text .. "_Dropdown"
    container.Size = UDim2.new(1, -8, 0, 48)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ZIndex = zIndex

    local label = Instance.new("TextLabel", container)
